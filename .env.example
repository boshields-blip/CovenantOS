# CovenantOS — required environment variables
#
# Pass these at Flutter build/run time via --dart-define:
#
#   flutter run \
#     --dart-define=COVENANT_SUPABASE_URL=https://your-project.supabase.co \
#     --dart-define=COVENANT_SUPABASE_ANON_KEY=your-anon-key
#
# In CI/CD (GitHub Actions), store these as repository secrets and reference
# them in the workflow build step. Never commit real values to this file.
#
# Both variables must be set for backend connectivity. When either is absent,
# the app boots in offline/demo mode (no Supabase calls, no auth guard).

# URL of the shared community Supabase project (CovenantOS + CommunityOS).
# This is NOT the PlumbLineOS (TradeCore) Supabase project.
COVENANT_SUPABASE_URL=

# Public anon key for the shared community Supabase project.
COVENANT_SUPABASE_ANON_KEY=

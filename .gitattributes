# Normalize line endings to LF across the repository.
# Prevents CRLF/LF churn in diffs regardless of contributor OS.
* text=auto eol=lf

# Explicit text types (kept LF in the working tree and repository)
*.md      text eol=lf
*.svelte  text eol=lf
*.js      text eol=lf
*.ts      text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.xml     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.svg     text eol=lf
*.txt     text eol=lf

# Binary assets — never touch line endings
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.pdf     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.otf     binary

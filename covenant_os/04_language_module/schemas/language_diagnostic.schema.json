{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LanguageDiagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_text",
    "detections",
    "summary"
  ],
  "properties": {
    "input_text": {
      "type": "string",
      "minLength": 1
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phrase",
          "category",
          "philosophical_root",
          "covenantal_alternative"
        ],
        "properties": {
          "phrase": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "Metaphysics",
              "Epistemology",
              "Anthropology",
              "Ethics",
              "Social/Political",
              "Identity/Meaning",
              "Eschatology"
            ]
          },
          "philosophical_root": {
            "type": "string",
            "minLength": 1
          },
          "covenantal_alternative": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}

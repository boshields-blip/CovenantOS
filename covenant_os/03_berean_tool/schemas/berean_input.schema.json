{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BereanInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "teacher_name",
    "education",
    "tradition",
    "mentors",
    "teaching_corpus_refs",
    "behavioral_notes"
  ],
  "properties": {
    "teacher_name": {
      "type": "string",
      "minLength": 1
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "institution"
        ],
        "properties": {
          "institution": {
            "type": "string",
            "minLength": 1
          },
          "degree": {
            "type": "string"
          },
          "focus": {
            "type": "string"
          },
          "years": {
            "type": "string"
          }
        }
      }
    },
    "tradition": {
      "type": "string",
      "minLength": 1
    },
    "mentors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "teaching_corpus_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "type"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "behavioral_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
